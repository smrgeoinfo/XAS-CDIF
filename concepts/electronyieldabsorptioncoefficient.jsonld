  "@id": "https://w3id.org/cdif/xas/electronyieldabsorptioncoefficient",
  "@type": [
    "skos:Concept"
  ],
  "skos:prefLabel": {
    "@value": "Electron yield absorption coefficient",
    "@language": "en"
  },
  "rdfs:seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_tey.html",
  "skos:broader": [
    {
      "@id": "https://w3id.org/cdif/xas/absorptioncoefficient"
    }
  ],
  "skos:definition": {
    "@value": "Absorption coefficient derived from electron yield, proportional to the ratio of the electron yield intensity and the incident beam intensity.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  },
